{
  "name": "@agentkib/web",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "build:hosted": "pnpm typecheck && vite build --mode hosted",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "test": "vitest run",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@agentkib/agent-identity": "workspace:*",
    "@agentkib/conversation-state": "workspace:*",
    "@agentkib/session-catalog": "workspace:*",
    "@agentkib/session-ui": "workspace:*",
    "@agentkib/web-client": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-router": "^1.170.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-cli": "^1.167.45",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
