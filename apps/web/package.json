    "@agentkib/session-ui": "workspace:*",
    "@agentkib/web-client": "workspace:*",
    "@octanejs/lucide": "0.1.56",
    "@octanejs/tanstack-router": "0.2.4",
    "@octanejs/tanstack-start": "0.2.4",
    "@fontsource-variable/geist": "^5.3.0",
    "octane": "0.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
