{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "AgentKib",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "maximizable": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": ["../resources/icons/icon.ico"],
    "resources": {
      "../resources/quota/resources/windows/": "windows/",
      "../resources/quota/resources/licenses/Win-CodexBar-LICENSE.txt": "licenses/Win-CodexBar-LICENSE.txt",
      "../resources/quota/resources/licenses/Win-CodexBar-NOTICE.txt": "licenses/Win-CodexBar-NOTICE.txt"
    },
    "windows": {
      "minimumWebview2Version": "111.0.1661.15",
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../resources/icons/icon.ico"
      }
    }
  }
}
