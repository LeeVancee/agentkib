{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentKib",
  "version": "0.5.0",
  "identifier": "ai.agentkib",
  "build": {
    "beforeDevCommand": "pnpm quota:prepare && pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm quota:prepare && pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentKib",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2RkI4RjFBQUFGRDExQUIKUldTckVmMnFHby83NXNLYXAxdUx2NFYvSytkcFB4amh1OFQvVXo1dTlnOWR1dWI3eTNFeE9JZmEK",
      "endpoints": ["https://github.com/starroyhq/agentkib/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../resources/icons/32x32.png",
      "../resources/icons/128x128.png",
      "../resources/icons/128x128@2x.png"
    ]
  }
}
