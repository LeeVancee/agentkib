{
  "name": "agentkib",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "diagnose:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/desktop/scripts/diagnose-windows.ps1",
    "dev": "pnpm --filter @agentkib/desktop dev",
    "dev:electron": "pnpm --filter @agentkib/desktop dev:electron",
    "build": "pnpm --filter @agentkib/desktop build",
    "dist:electron": "pnpm --filter @agentkib/desktop dist:electron",
    "benchmark:runtime": "pnpm --filter @agentkib/desktop benchmark:runtime",
    "format": "oxfmt apps/desktop/src apps/desktop/electron apps/desktop/vite*.config.ts",
    "format:check": "oxfmt --check apps/desktop/src apps/desktop/electron apps/desktop/vite*.config.ts",
    "lint": "oxlint apps/desktop/src apps/desktop/electron",
    "lint:fix": "oxlint apps/desktop/src apps/desktop/electron --fix",
    "test": "pnpm --filter @agentkib/desktop test",
    "typecheck": "pnpm --filter @agentkib/desktop typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  }
}
