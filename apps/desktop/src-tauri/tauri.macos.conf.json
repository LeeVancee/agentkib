{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "AgentKib",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 15, "y": 25 },
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "icon": [
      "../resources/icons/icon.icns",
      "../resources/icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "externalBin": ["../resources/quota/binaries/agentkib-quota-sidecar"],
    "resources": {
      "../resources/quota/resources/CodexBar_CodexBarCore.bundle/": "CodexBar_CodexBarCore.bundle/",
      "../resources/quota/resources/licenses/CodexBar-LICENSE.txt": "licenses/CodexBar-LICENSE.txt"
    }
  }
}
