{
  "name": "@agentkib/web",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "build:hosted": "pnpm typecheck && vite build --mode hosted",
